# Copy this file to .env when using cloud VLM features.
# Core CAD generation, the web UI, Gallery, and the current showroom assets
# do not require these values.

# Zhipu GLM visual model API key. Leave empty to disable VLM calls.
GLM_API_KEY=

# Optional override used by VLM scripts when supported.
GLM_MODEL=glm-4.6v

# Optional local runtime hints.
AICAD_HOST=127.0.0.1
AICAD_PORT=8010
